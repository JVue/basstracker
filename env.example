# Copy this file to env.local (for local dev) or env.docker (for Docker Compose)
# and fill in your values. Neither file should be committed to version control.

# A long random string used to sign session cookies
SESSION_SECRET=change_me_to_a_long_random_string

# PostgreSQL connection
DB_HOST=localhost        # use 'postgres' for Docker Compose
DB_NAME=basstracker
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Redis connection
REDIS_HOST=localhost     # use 'redis' for Docker Compose
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
